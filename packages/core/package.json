{
  "name": "@tacet/core",
  "version": "0.1.0",
  "description": "Local-first meeting transcription and grounded minutes: whisper.cpp + Ollama, no cloud.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OwlHugo/tacet.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "whisper",
    "whisper.cpp",
    "ollama",
    "transcription",
    "meeting-notes",
    "local-first",
    "offline"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
