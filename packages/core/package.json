{
  "name": "@tacet/core",
  "version": "0.1.0",
  "description": "Local-first meeting transcription and grounded minutes: whisper.cpp + Ollama, no cloud.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=22.18" },
  "keywords": ["whisper", "whisper.cpp", "ollama", "transcription", "meeting-notes", "local-first", "offline"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
