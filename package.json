{
  "name": "tacet-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "eval": "pnpm --filter tacet run build && node apps/cli/dist/index.js eval --dataset eval/dataset --report eval/results.json",
    "desktop": "pnpm --filter @tacet/desktop run dev",
    "dist": "pnpm --filter @tacet/desktop run dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
